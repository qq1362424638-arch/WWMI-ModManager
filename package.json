{
  "name": "wwmi-mod-manager",
  "version": "0.1.0",
  "description": "WWMI Mod Manager",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win nsis",
    "dist:win:dir": "electron-builder --win dir",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File build/release-win.ps1"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.wwmi.modmanager",
    "productName": "WWMI Mod Manager",
    "executableName": "WWMI-ModManager",
    "directories": {
      "output": "dist"
    },
    "artifactName": "WWMI-ModManager-Setup-${version}-${arch}.${ext}",
    "asar": false,
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "WWMI Mod Manager"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WWMI Mod Manager",
      "uninstallDisplayName": "WWMI Mod Manager"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
